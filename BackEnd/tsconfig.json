{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "moduleResolution": "node",
  
      "rootDir": "src",
      "outDir": "dist",
  
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
  
      "typeRoots": ["./src/@types", "./node_modules/@types"]
    },
    "include": ["src"],
    "exclude": ["node_modules"]
  }