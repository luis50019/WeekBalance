---
import StitchLayout from '../layouts/StitchLayout.astro';
import AccordionItem from '../components/AccordionItem.astro';
import SubAccordion from '../components/SubAccordion.astro';
---

<StitchLayout>
  <!-- TopNavBar -->
  <header
    class="fixed top-0 w-full z-50 bg-[#0f172a]/80 backdrop-blur-[12px] border-b border-[#334155] h-16 shadow-none font-manrope antialiased tracking-tight"
  >
    <div class="flex justify-between items-center h-16 px-6 max-w-[1280px] mx-auto">
      <div class="flex items-center gap-8">
        <span class="text-lg font-bold text-slate-50">WeekBalance Docs</span>
        <nav class="hidden md:flex gap-6">
          <a class="text-blue-500 font-semibold transition-all" href="#">Documentación</a>

        </nav>
      </div>
      
    </div>
  </header>

  <div class="flex max-w-7xl mx-auto w-full min-w-0 overflow-hidden">
    <!-- SideNavBar -->
    <aside
      class="fixed left-0 top-16 h-[calc(100vh-64px)] w-64 bg-[#020617] border-r border-slate-700 overflow-y-auto custom-scrollbar hidden lg:block flex-shrink-0"
    >
      <div class="flex flex-col gap-1 py-8 font-manrope text-sm font-medium">
        <div class="px-6 mb-6">
          <h2 class="text-xl font-black text-slate-50 uppercase tracking-tighter">WeekBalance</h2>
          <p class="text-xs text-slate-500 uppercase tracking-widest mt-1">Documentación</p>
        </div>

        <div class="mb-4">
          <div class="px-6 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-widest">
            Manuales
          </div>
          <a
            class="flex items-center gap-3 px-4 py-2 text-blue-400 border-l-2 border-blue-500 bg-blue-500/10 hover:bg-slate-800/30 transition-all duration-200"
            href="#"
          >
            <span class="material-symbols-outlined">person</span>
            Usuario
          </a>
          <a
            class="flex items-center gap-3 px-4 py-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800/30 transition-all duration-200"
            href="/tecnico"
          >
            <span class="material-symbols-outlined">engineering</span>
            Técnico
          </a>
          <a
            class="flex items-center gap-3 px-4 py-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800/30 transition-all duration-200"
            href="/instalacion"
          >
            <span class="material-symbols-outlined">install_desktop</span>
            Instalación
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 min-w-0 w-full lg:pl-64 lg:pr-[280px] px-4 pt-24 pb-20 overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 w-full min-w-0 overflow-hidden break-words">
        <!-- Título -->
        <header class="mb-section-gap">
          <h1 class="font-h1 text-h1 text-slate-50 mb-4">WeekBalance - Manual de Usuario</h1>
          <p class="font-body text-body text-on-surface-variant leading-relaxed">
            <strong>WeekBalance</strong> es una app de finanzas personales que combina una experiencia
            móvil construida con Expo/React Native y un backend en la nube. Está pensada para que controles
            tu dinero semana a semana (domingo a sábado).
          </p>
        </header>

        <!-- Info Alert -->
        <div
          class="mb-section-gap flex gap-4 bg-primary-container/10 border-l-4 border-primary p-6 rounded-r-xl"
        >
          <span class="material-symbols-outlined text-primary">cloud_done</span>
          <div>
            <p class="font-body text-body text-on-surface">
              Todo se sincroniza automáticamente con los servicios de Supabase, por lo que conservás
              tus datos aunque cambies de dispositivo.
            </p>
          </div>
        </div>

        <!-- Requisitos del Sistema -->
        <section class="mb-section-gap" id="requisitos">
          <h2 class="font-h2 text-h2 text-slate-50 mb-6">Requisitos del Sistema</h2>
          <div class="space-y-4">
            <div class="p-4 bg-surface-container rounded-xl border border-outline-variant/30">
              <h3 class="font-h3 text-h3 text-slate-50 mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">phone_android</span>
                Dispositivo Compatible
              </h3>
              <ul class="text-on-surface-variant space-y-1">
                <li>
                  <strong>Android</strong> 8.0 o superior / <strong>iOS</strong> 13.0 o superior.
                </li>
                <li>Pantalla mínima 360 x 640 px.</li>
                <li>Al menos 150 MB de memoria disponible.</li>
              </ul>
            </div>
            <div class="p-4 bg-surface-container rounded-xl border border-outline-variant/30">
              <h3 class="font-h3 text-h3 text-slate-50 mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">wifi</span>
                Conexión a Internet
              </h3>
              <p class="text-on-surface-variant">
                Es obligatoria para registrar cuenta, iniciar sesión, sincronizar movimientos y ver
                reportes.
              </p>
            </div>
            <div class="p-4 bg-surface-container rounded-xl border border-outline-variant/30">
              <h3 class="font-h3 text-h3 text-slate-50 mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">storage</span>
                Espacio en el Dispositivo
              </h3>
              <ul class="text-on-surface-variant space-y-1">
                <li>Instalación ~80 MB (Expo + assets).</li>
                <li>Recomendado 200 MB libres.</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Almacenamiento -->
        <section class="mb-section-gap" id="almacenamiento">
          <h2 class="font-h2 text-h2 text-slate-50 mb-6">Almacenamiento de Datos</h2>
          <h3 class="font-h3 text-h3 text-slate-50 mb-3">Cómo se Guardan tus Datos</h3>
          <ul class="text-on-surface-variant space-y-2 mb-4">
            <li>
              <strong>Nube (Supabase Postgres)</strong>: Cada transacción, meta y perfil se guarda
              en la base central.
            </li>
            <li>
              <strong>Dispositivo</strong>: Solo se guarda el token de sesión cifrado
              (AsyncStorage).
            </li>
          </ul>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[#334155]">
                  <th class="text-left py-3 px-4 text-slate-400 font-semibold">Situación</th>
                  <th class="text-left py-3 px-4 text-slate-400 font-semibold"
                    >¿Qué sucede con tus datos?</th
                  >
                </tr>
              </thead>
              <tbody class="text-on-surface-variant">
                <tr class="border-b border-[#334155]/50">
                  <td class="py-3 px-4">Desinstalar la app</td>
                  <td class="py-3 px-4"
                    >Al reinstalar e iniciar sesión, se sincronizan nuevamente tus datos desde
                    Supabase.</td
                  >
                </tr>
                <tr class="border-b border-[#334155]/50">
                  <td class="py-3 px-4">Cambiar de teléfono</td>
                  <td class="py-3 px-4"
                    >Basta con instalar WeekBalance e iniciar sesión con tu correo/contraseña
                    originales.</td
                  >
                </tr>
                <tr class="border-b border-[#334155]/50">
                  <td class="py-3 px-4">Formatear el dispositivo</td>
                  <td class="py-3 px-4"
                    >Los datos persisten en la nube; solo necesitás recordar tus credenciales.</td
                  >
                </tr>
                <tr>
                  <td class="py-3 px-4">Sin conexión</td>
                  <td class="py-3 px-4"
                    >Podés revisar lo último cargado, pero las operaciones quedan pendientes hasta
                    reconectar.</td
                  >
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Navegación -->
        <section class="mb-section-gap" id="navegacion">
          <h2 class="font-h2 text-h2 text-slate-50 mb-6">Navegación</h2>
          <p class="text-on-surface-variant mb-4">
            La barra inferior fija incluye tres accesos principales:
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-[#334155]">
                  <th class="text-left py-3 px-4 text-slate-400 font-semibold">Sección</th>
                  <th class="text-left py-3 px-4 text-slate-400 font-semibold">Icono</th>
                  <th class="text-left py-3 px-4 text-slate-400 font-semibold">Descripción</th>
                </tr>
              </thead>
              <tbody class="text-on-surface-variant">
                <tr class="border-b border-[#334155]/50">
                  <td class="py-3 px-4 font-semibold text-slate-200">Inicio</td>
                  <td class="py-3 px-4">Casa</td>
                  <td class="py-3 px-4"
                    >Vista general: balance, metas, tendencias y últimos gastos.</td
                  >
                </tr>
                <tr class="border-b border-[#334155]/50">
                  <td class="py-3 px-4 font-semibold text-slate-200">Ingresos</td>
                  <td class="py-3 px-4">Billetera</td>
                  <td class="py-3 px-4"
                    >Historial semanal de ingresos, filtros por categoría y botón de alta.</td
                  >
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-200">Gastos</td>
                  <td class="py-3 px-4">Dinero</td>
                  <td class="py-3 px-4"
                    >Historial semanal de gastos, filtros por categoría y botón de alta.</td
                  >
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-on-surface-variant">
            Tocando tu avatar en la cabecera accedés al <strong>Perfil</strong>.
          </p>
        </section>

        <!-- Funcionalidades -->
        <section class="mb-section-gap" id="funcionalidades">
          <h2 class="font-h2 text-h2 text-slate-50 mb-6">Funcionalidades</h2>

          <div class="space-y-6">
            <!-- Registro e Inicio de Sesión (MAIN STATIC) -->
            <div
              class="w-full max-w-full overflow-hidden bg-slate-800 border border-slate-700 rounded-xl p-4"
            >
              <h3 class="font-h3 text-h3 text-slate-50 mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-blue-400">person_add</span>
                Registro e Inicio de Sesión
              </h3>

              <div class="flex flex-col space-y-4">
                <SubAccordion title="Crear una cuenta nueva">
                  <div class="flex flex-col space-y-3 text-on-surface-variant text-sm">
                    <p class="text-slate-300">Seguí estos pasos para crear tu cuenta:</p>
                    <ol class="list-decimal pl-4 space-y-3">
                      <li class="leading-tight">
                        Pulsá <strong>"Regístrate"</strong> en la pantalla principal.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_1.jpeg"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Cargá tu nombre completo, correo electrónico y contraseña.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_3.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Confirmá con <strong>"Crear cuenta"</strong>.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_6.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                    </ol>
                    <p class="mt-2 text-xs text-slate-400">
                      El sistema crea tu perfil, cuenta y sesión en Supabase automáticamente.
                    </p>
                  </div>
                </SubAccordion>

                <SubAccordion title="Iniciar sesión">
                  <div class="flex flex-col space-y-3 text-on-surface-variant text-sm">
                    <ol class="list-decimal pl-4 space-y-3">
                      <li>
                        Introducí tu correo electrónico.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_4.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Ingresá tu contraseña.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_5.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Tocá <strong>"Iniciar sesión"</strong>.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_5_.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Esperá la sincronización inicial (balance y movimientos se cargan desde la
                        nube).
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_6.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                    </ol>
                  </div>
                </SubAccordion>

                <SubAccordion title="Cerrar sesión">
                  <div class="flex flex-col space-y-3 text-on-surface-variant text-sm">
                    <ol class="list-decimal pl-4 space-y-3">
                      <li>
                        Desde cualquier pantalla, tocá tu el icono de salir en la esquina superior
                        derecha.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_6_.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Confirmá la acción.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/register/imagen_7.jpeg"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                    </ol>
                    <p class="mt-2 text-xs text-slate-400">
                      Esto borra el token local y regresa a la pantalla de autenticación.
                    </p>
                  </div>
                </SubAccordion>
              </div>
            </div>

            <!-- Gestionar Ingresos (MAIN STATIC) -->
            <div
              class="w-full max-w-full overflow-hidden bg-slate-800 border border-slate-700 rounded-xl p-4"
            >
              <h3 class="font-h3 text-h3 text-slate-50 mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-blue-400">trending_up</span>
                Gestionar Ingresos
              </h3>
              <p class="text-on-surface-variant mb-4">
                Los ingresos representan entradas de dinero (sueldos, freelance, regalos, etc.).
              </p>

              <div class="flex flex-col space-y-4">
                <SubAccordion title="Ver historial">
                  <div class="flex flex-col space-y-3 text-on-surface-variant text-sm">
                    <ol class="list-decimal pl-4 space-y-3">
                      <li>
                        Abrí la sección <strong>Ingresos</strong> desde la barra de navegación.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_1.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                    </ol>
                  </div>
                </SubAccordion>

                <SubAccordion title="Agregar ingreso">
                  <div class="flex flex-col space-y-3 text-on-surface-variant text-sm">
                    <ol class="list-decimal pl-4 space-y-3">
                      <li>
                        Botón flotante <strong>Agregar</strong> en la parte inferior.+
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_1_.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Seleccioná una categoría (ej. "Trabajo", "Regalo").
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_3.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Escribí una descripción (opcional pero recomendable).
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_3.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Ingresá el monto positivo con dos decimales.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_3.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Guardá. El backend ajusta tu saldo y las metas automáticamente.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_3.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                    </ol>
                  </div>
                </SubAccordion>

                <SubAccordion title="Editar ingreso">
                  <div class="flex flex-col space-y-3 text-on-surface-variant text-sm">
                    <ol class="list-decimal pl-4 space-y-3">
                      <li>
                        Desde la lista, tocá el movimiento que deseás modificar.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_5.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Modificá el monto, categoría o descripción.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_4.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Confirmá con <strong>Actualizar ingreso</strong>.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/ingresos/imagen_5.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                    </ol>
                    <p class="mt-2 text-xs text-slate-400">
                      La actualización se envía a la API /incomes/update/ y se refleja en balance y
                      metas.
                    </p>
                  </div>
                </SubAccordion>
              </div>
            </div>

            <!-- Gestionar Gastos (MAIN STATIC) -->
            <div
              class="w-full max-w-full overflow-hidden bg-slate-800 border border-slate-700 rounded-xl p-4"
            >
              <h3 class="font-h3 text-h3 text-slate-50 mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-blue-400">payments</span>
                Gestionar Gastos
              </h3>
              <p class="text-on-surface-variant mb-4">
                Los gastos abarcan todo egreso (alimentación, transporte, ocio, etc.).
              </p>

              <div class="flex flex-col space-y-4">
                <SubAccordion title="Ver historiall">
                  <div class="flex flex-col space-y-3 text-on-surface-variant text-sm">
                    <ol class="list-decimal pl-4 space-y-3">
                      <li>
                        Abrí la sección <strong>Gastos</strong> desde la barra de navegación.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
                            src="/images/gastos/imagen_10_.png"
                            class="block w-1/2 h-auto mt-2 rounded-md"
                            alt="Pantalla de registro"
                          />
                        </div>
                      </li>
                      <li>
                        Revisá los bloques semanales con totales y fechas.
                        <div
                          class="w-full h-auto max-w-full bg-slate-700 border border-slate-600 rounded-lg flex items-center justify-center text-slate-400 text-sm mt-2 overflow-hidden"
                        >
                          <img
